/dts-v1/;

/ {
	description = "U-boot FIT image for k1x";
	#address-cells = <2>;
	fit,fdt-list = "of-list";

	images {
		barebox {
			description = "barebox";
			type = "standalone";
			os = "barebox";
			arch = "riscv";
			compression = "none";
			load = <0x0 0x00200000>;
			data = /incbin/("./barebox-spacemit-k1.img");
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "conf_1";

		conf_1 {
			description = "barebox standalone";
			loadables = "barebox";
			hash-1 {
				algo = "crc32";
			};
		};
	};
};
